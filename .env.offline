APP_NAME="Nameless POS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - SQLite (Offline Ready)
DB_CONNECTION=sqlite
DB_DATABASE=./database/app.sqlite

# Cache
CACHE_DRIVER=file
CACHE_STORE=file

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=sync

# Mail (Optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@namelesspos.local
MAIL_FROM_NAME="${APP_NAME}"

# Offline Mode
OFFLINE_MODE=true
OFFLINE_SYNC_INTERVAL=300

# File Upload
FILESYSTEM_DISK=public
