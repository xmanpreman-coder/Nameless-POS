{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nameless POS",
  "version": "1.0.0",
  "identifier": "com.nameless.pos",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:8000",
    "beforeDevCommand": "php artisan serve",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nameless POS - Tauri",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        {
          "identifier": "fs:allow-writes",
          "permissions": [
            "fs:allow-write-text-file"
          ]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    }
  },
  "plugins": {}
}
